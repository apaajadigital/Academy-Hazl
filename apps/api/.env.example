# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/jago_akademi"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 48
JWT_SECRET="change-me-at-least-32-characters-long!!"
JWT_REFRESH_SECRET="change-me-refresh-at-least-32-chars!!"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://api.jagoakademi.com/api/auth/google/callback"

# ─── App URLs ─────────────────────────────────────────────────────────────────
PORT=4000
WEB_URL="https://jagoakademi.com"
CORS_ORIGIN="https://jagoakademi.com"

# ─── Cookie ───────────────────────────────────────────────────────────────────
COOKIE_SECURE="true"
COOKIE_DOMAIN=".jagoakademi.com"

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB="50"

# Cloudflare R2 (production object storage)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="jago-akademi-media"
R2_PUBLIC_URL="https://media.jagoakademi.com"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_live_xxxxxxxxxxxx"
EMAIL_FROM="noreply@jagoakademi.com"
EMAIL_FROM_NAME="Jago Akademi"

# ─── Payment (DOKU) ───────────────────────────────────────────────────────────
DOKU_CLIENT_ID="your-doku-client-id"
DOKU_SECRET_KEY="your-doku-secret-key"
# Selects sandbox vs production base URL (unless DOKU_BASE_URL overrides).
DOKU_IS_PRODUCTION="false"
# Optional explicit override. Production: https://api.doku.com | Sandbox: https://api-sandbox.doku.com
DOKU_BASE_URL=""
# BL-147 — which methods DOKU may DISPLAY at checkout. Comma-separated.
# Unset or empty = the in-code default below (safe). The literal "ALL" — and only
# that — sends no restriction, which is DOKU's "show everything": 31 methods on
# this account, including PEER_TO_PEER_KREDIVO / _AKULAKU / _INDODANA /
# _BRI_CERIA. Those paylater methods need line_items.id/.sku/.category/.url/
# .image_url/.type and customer address fields that we do not send, so a buyer
# picking one fails with DOKU case code 02 AFTER the order row already exists.
# Paylater codes are REJECTED at startup until those fields are sent.
# 🖐️ Confirm these codes against the sandbox before production — RUNBOOK_DEPLOY.md §7.1.
DOKU_PAYMENT_METHOD_TYPES="VIRTUAL_ACCOUNT_BCA,VIRTUAL_ACCOUNT_BANK_MANDIRI,VIRTUAL_ACCOUNT_BRI,VIRTUAL_ACCOUNT_BNI,VIRTUAL_ACCOUNT_BANK_PERMATA,VIRTUAL_ACCOUNT_BANK_SYARIAH_MANDIRI,VIRTUAL_ACCOUNT_DOKU,CREDIT_CARD,EMONEY_OVO,EMONEY_SHOPEEPAY,EMONEY_DANA,QRIS"
# BL-145 — replay window for inbound webhook notifications (seconds).
# Deliberately wide: DOKU redelivers with the ORIGINAL Request-Timestamp and its
# retry horizon has never been measured, so a narrow window would reject real
# payment notifications. Measured clock skew against DOKU sandbox was under 2s.
# Every notification logs its skew ("doku notification timestamp skew") — tighten
# this once the real distribution is visible (BL-150).
DOKU_WEBHOOK_MAX_AGE_SECONDS="86400"
# How far into the future a notification stamp may sit. Covers host clock drift,
# not DOKU behaviour.
DOKU_WEBHOOK_MAX_FUTURE_SECONDS="900"
# BL-144 — payment reconciliation sweep. Asks DOKU's Check Status API what really
# happened to pending orders whose expiredAt has passed, so a lost notification
# stops being terminal. Requires REDIS_URL (the sweep is a BullMQ repeatable job
# registered by the worker at startup).
RECONCILE_INTERVAL_MINUTES="15"
RECONCILE_BATCH_SIZE="100"

# ─── Search (Meilisearch) ─────────────────────────────────────────────────────
MEILISEARCH_URL="http://localhost:7700"
MEILISEARCH_KEY="your-meilisearch-master-key"

# ─── WhatsApp (Fonnte, optional) ──────────────────────────────────────────────
FONNTE_TOKEN=""

# ─── Feature flags ────────────────────────────────────────────────────────────
# Block login for unverified emails (OFF by default; see docs before enabling).
ENFORCE_EMAIL_VERIFICATION="false"

# ─── Video (Cloudflare Stream, optional) ──────────────────────────────────────
CLOUDFLARE_STREAM_ACCOUNT_ID=""
CLOUDFLARE_STREAM_TOKEN=""

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=""
# Stamps /api/health `version` and the Sentry release. Leave empty and health
# reports a hardcoded "1.0.0" while Sentry errors carry no release at all, so you
# cannot tell which deploy produced an error. Set to the released git sha or tag.
APP_VERSION=""
# NOTE: read by nothing. src/config/env.ts has no SENTRY_ENVIRONMENT key and Zod
# strips unknown keys, so setting this has no effect — instrument.ts derives the
# environment from NODE_ENV. Kept only to avoid re-adding it by guesswork.
SENTRY_ENVIRONMENT="production"

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV="production"
