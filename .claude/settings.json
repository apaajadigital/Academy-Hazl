{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash scripts/ops/jago.sh:*)",
      "Bash(ssh jago-vps:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh variable list:*)",
      "Bash(gh secret list:*)",
      "Bash(gh api repos/haluanitcore/Jago-Akademi-Website1:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run check-types:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx vitest run:*)"
    ],
    "deny": [
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh secret set:*)",
      "Bash(gh secret delete:*)"
    ]
  }
}
